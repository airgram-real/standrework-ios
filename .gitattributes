# Normalise line endings in the repository and on checkout.
* text=auto

# Shell scripts MUST stay LF, otherwise they fail on macOS runners.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.m    text eol=lf
*.h    text eol=lf
*.c    text eol=lf
*.md   text eol=lf

# binaries
*.dylib binary
*.a     binary
